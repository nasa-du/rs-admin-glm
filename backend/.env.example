# rs-admin backend 环境变量样例（docs/spec.md §9.2）
# 复制为 backend/.env 后按需修改：cp .env.example .env

# Postgres 连接串（docker compose up -d db 后即为可用缺省值）
DATABASE_URL=postgres://rs_admin:rs_admin@localhost:5432/rs_admin

# JWT 签发密钥：>=32 字节随机串，如 `openssl rand -base64 48`
# 生产环境走 secret/env 注入（docker-compose.prod.yml）
JWT_SECRET=

# development | production：tracing 输出（pretty/JSON）、Swagger 挂载开关
APP_ENV=development

# 监听地址与端口（IP 形式）。容器内需 0.0.0.0 才可达；宿主开发保持缺省
HOST=127.0.0.1
PORT=3000

# 同源静态伺服（spec §9.3）：指向前端构建产物目录（须含 index.html）。
# 设置后 axum 在同端口伺服前端并带 SPA 回退；不设置 = 开发模式（Vite 5173 负责页面）。
# 运行镜像内固定为 /app/frontend-dist
# FRONTEND_DIST=

# 日志级别（tracing EnvFilter）
RUST_LOG=info,sqlx=warn
